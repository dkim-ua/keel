# ─────────────────────────────────────────────────────────────
# Site
# ─────────────────────────────────────────────────────────────
# Public production URL, no trailing slash. Used for canonical URLs,
# hreflang, sitemap.xml, Open Graph and Schema.org.
NEXT_PUBLIC_SITE_URL=keel-gold.vercel.app

# Optional. Shown in the footer, contact page and Schema.org ONLY when set.
# Leave empty until the company has a real address.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional. Social links are rendered ONLY when set.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=

# ─────────────────────────────────────────────────────────────
# Contact form delivery (server-side only, never exposed to the browser)
# Configure at least ONE channel. All configured channels receive every lead.
# In production the form returns an error if no channel is configured,
# so leads are never silently lost.
# ─────────────────────────────────────────────────────────────

# 1) Telegram — create a bot via @BotFather and put its token here.
#    TELEGRAM_CHAT_ID: numeric chat ids of the recipients, comma-separated.
#    Every recipient gets every lead. Each person must open the bot and press
#    Start once, otherwise Telegram does not allow the bot to message them.
#    Usernames (@name) do not work — use numeric ids (get yours from @userinfobot).
#    Example: TELEGRAM_CHAT_ID=123456789,987654321
TELEGRAM_BOT_TOKEN=8967627024:AAFoAd6oA_4ec-M3mi6Alli8mzYGLvWZy74
TELEGRAM_CHAT_ID=493899998, 602834297

# 2) Email via Resend (https://resend.com). FROM must be on a verified domain.
RESEND_API_KEY=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=

# 3) Generic webhook — CRM, HubSpot/Pipedrive via Make, Zapier, n8n, your own backend.
#    Receives JSON. If a secret is set, the body is signed with HMAC-SHA256
#    and sent in the X-Keel-Signature header (format: sha256=<hex>).
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=
